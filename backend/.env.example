# Healthcare AI Assistant - Backend Environment Variables

# Environment
# Options: development, production, testing
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
SERVER_NAME="Healthcare AI Assistant"
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Configuration
# Options: sqlite (development) or postgresql (production)
DB_DRIVER=sqlite

# For PostgreSQL (uncomment and configure for production)
# DB_DRIVER=postgresql
# DB_USER=healthcare
# DB_PASSWORD=secure_password_here
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=healthcare_db

# CORS Configuration
# Development: localhost URLs
# Production: Add your Vercel frontend and other allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://healthcare-ai-assistant-beta.vercel.app

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MCP Server Configuration
# Development: Local MCP server
# Production: Deployed MCP server URL
MCP_SERVER_URL=http://localhost:8001
# Production example:
# MCP_SERVER_URL=https://healthcare-ai-assistant-r0mw.onrender.com

# Features
ENABLE_DATABASE_MIGRATIONS=true
ENABLE_SAMPLE_DATA=false

# Optional: API Keys for LLM Integration (future)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4
