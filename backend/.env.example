# Healthcare AI Assistant - Backend Environment Variables

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
SERVER_NAME="Healthcare AI Assistant"
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Configuration
# Options: sqlite (development) or postgresql (production)
DB_DRIVER=sqlite

# For PostgreSQL (uncomment and configure for production)
# DB_DRIVER=postgresql
# DB_USER=healthcare
# DB_PASSWORD=secure_password_here
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=healthcare_db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MCP Server
MCP_SERVER_URL=http://localhost:8001

# Features
ENABLE_DATABASE_MIGRATIONS=true
ENABLE_SAMPLE_DATA=false

# Optional: API Keys for LLM Integration (future)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4
