# Healthcare AI Assistant - MCP Server Environment Variables

# Environment
# Options: development, production, testing
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# Backend Service Configuration
# CRITICAL: This must point to the backend API service
# Development: Local backend
# Production: Deployed backend on Render
BACKEND_URL=http://localhost:8000
# Production example:
# BACKEND_URL=https://healthcare-ai-assistant-1.onrender.com

# Optional: LLM Integration (for future AI enhancements)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4
